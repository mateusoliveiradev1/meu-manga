{
  "name": "scaffold-tmp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "backup": "tsx --env-file=.env scripts/backup.ts",
    "backup:verify": "tsx --env-file=.env scripts/verify-backup.ts",
    "backup:restore": "tsx --env-file=.env scripts/restore-backup.ts",
    "db:migrate": "drizzle-kit migrate",
    "images:migrate": "tsx --env-file=.env scripts/migrate-local-images.ts",
    "test:audit": "node scripts/audit.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc --noEmit",
    "quality": "npm run typecheck && npm run build",
    "vercel-build": "drizzle-kit migrate && next build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.6.29",
    "cloudinary": "^2.10.0",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.1",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.20.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
